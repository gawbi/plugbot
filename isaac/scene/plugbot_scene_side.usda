#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 800
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 2500
        float3 xformOp:rotateXYZ = (-40, 20, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Cube "Quay" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.62, 0.63, 0.64)]
        double size = 1
        float3 xformOp:scale = (0.22, 0.6, 0.15)
        double3 xformOp:translate = (0.009999999999999995, 0, -0.075)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Water"
    {
        color3f[] primvars:displayColor = [(0.18, 0.42, 0.62)]
        double size = 1
        float3 xformOp:scale = (3, 3, 0.002)
        double3 xformOp:translate = (0, 0, -0.101)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Ship" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.512, 0, -0.055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "Hull" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.86, 0.87, 0.89)]
            double size = 1
            float3 xformOp:scale = (0.32, 0.26, 0.07)
            double3 xformOp:translate = (0, 0, -0.035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Stripe"
        {
            color3f[] primvars:displayColor = [(0.75, 0.16, 0.14)]
            double size = 1
            float3 xformOp:scale = (0.322, 0.262, 0.012)
            double3 xformOp:translate = (0, 0, -0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Cabin" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.95, 0.95, 0.96)]
            double size = 1
            float3 xformOp:scale = (0.1, 0.16, 0.06)
            double3 xformOp:translate = (0.07, 0, 0.03)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "Socket"
        {
            quatf xformOp:orient = (0.70710677, 0, -0.70710677, 0)
            double3 xformOp:translate = (-0.16600000000000004, 0, 0.08499999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

